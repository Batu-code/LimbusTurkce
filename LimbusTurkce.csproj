<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 her Windows 10 ve 11'de kurulu geliyor -->
  <!-- Oyuncu hicbir sey kurmadan tek bir kucuk exe calistirir -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>LimbusTurkce</AssemblyName>
    <RootNamespace>LimbusTurkce</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Limbus Company Türkçe Yama</Product>
    <Description>Limbus Company Türkçe yamasını kurar ve günceller</Description>
    <Copyright>Batu-code</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>simge.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <!-- Oyunun arayuz gorselleri exe'nin icine gomulur -->
  <!-- Sartlari art/NOTICE.md icinde -->
  <ItemGroup>
    <EmbeddedResource Include="art\*.png" LogicalName="LimbusTurkce.art.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
